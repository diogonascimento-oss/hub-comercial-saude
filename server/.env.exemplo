# Copie este arquivo para ".env" e preencha os valores. O arquivo ".env" nunca deve ser enviado ao repositório.

# Conta do Kommo do Núcleo de Saúde
KOMMO_SUBDOMAIN=
KOMMO_TOKEN=

# Token que protege a API. Deve ser idêntico ao segredo API_TOKEN cadastrado no Worker do Cloudflare.
# Para gerar um valor: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=

# Upstash Redis: guarda apenas as exclusões e correções de eventos
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

PORT=3001

# Somente para desenvolvimento local: serve a pasta client/ pelo próprio servidor
# e dispensa o token. Nunca definir em produção.
# MODO_LOCAL=true
