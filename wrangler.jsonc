{
  // Configuração do Cloudflare Workers: entrega a interface (pasta client/) e
  // executa worker/index.js para as chamadas /api/*.
  "name": "saude",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./client"
  },
  // Preserva as variáveis cadastradas no painel do Cloudflare a cada deploy.
  // Os valores do Worker (API_ORIGEM, API_TOKEN, ACCESS_TEAM_DOMAIN e
  // ACCESS_AUD) não ficam neste arquivo: devem ser cadastrados no painel,
  // como "Secret".
  "keep_vars": true,
  // Endereços de pré-visualização ficam fora da política do Cloudflare Access;
  // por isso permanecem desativados.
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
