{
  // Configuração do Cloudflare Workers: entrega a interface (pasta client/) e
  // executa worker/index.js para as chamadas /api/*.
  "name": "saude",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./client",
    // Permite ao Worker buscar a página 404 entre os arquivos da interface.
    "binding": "ASSETS"
  },
  // Preserva as variáveis cadastradas no painel do Cloudflare a cada deploy.
  // Os valores do Worker (API_ORIGEM, API_TOKEN, ACCESS_TEAM_DOMAIN e
  // ACCESS_AUD) não ficam neste arquivo: devem ser cadastrados no painel,
  // como "Secret".
  "keep_vars": true,
  // Endereços de pré-visualização ficam fora da política do Cloudflare Access;
  // por isso permanecem desativados.
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  // Mantém o servidor do Render acordado no horário de trabalho: a cada 10
  // minutos, das 8h às 19h59 (Brasília), de segunda a sábado. A agenda do
  // Cloudflare usa UTC (Brasília + 3 h). Fora desse horário o servidor dorme e
  // não gasta horas gratuitas do Render (750 por mês, somadas entre os serviços
  // gratuitos da conta). Para desligar, apague esta linha e publique de novo.
  "triggers": {
    "crons": ["*/10 11-22 * * MON-SAT"]
  }
}
